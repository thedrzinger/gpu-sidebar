# /etc/systemd/system/gpu-metrics.service
#
# Runs the gpu-sidebar reporter (Node) on the GPU host so OpenCode
# sidebars on other machines can poll GPU stats over the LAN.
# Replaces the old Python-based gpu_metrics_server.service — same service
# name, so an existing install just swaps ExecStart.
#
# Install the reporter first: `npm i -g gpu-sidebar` (or `npx gpu-sidebar-reporter`
# to run it ad hoc without installing). Then adjust before installing this unit:
#   - User=            the account that owns the global npm install
#   - ExecStart        the real path to the installed bin (`which gpu-sidebar-reporter`)
#   - --port           the port you actually run it on (default 9100)
#
# Install (as root, via sudo), stopping any manual instance first:
#   sudo cp ~/gpu-sidebar-reporter.service.example /etc/systemd/system/gpu-metrics.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now gpu-metrics
#   systemctl status gpu-metrics --no-pager
#   curl http://127.0.0.1:9100/

[Unit]
Description=gpu-sidebar GPU metrics reporter
After=network.target

[Service]
Type=simple
User=YOUR-USER
ExecStart=/usr/local/bin/gpu-sidebar-reporter --port 9100
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
